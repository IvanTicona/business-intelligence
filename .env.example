# Copiá este archivo a .env en la VPS y completá los valores.
# El .env NO se commitea.

# --- Postgres ---
POSTGRES_USER=bi
POSTGRES_PASSWORD=cambiame-por-algo-largo-y-random
POSTGRES_DB=bi_course

# --- Backend ---
# Sin este token el backend no arranca. Generalo con: openssl rand -hex 32
ADMIN_TOKEN=cambiame-token-docente

# --- Público ---
# Tu dominio detrás de Cloudflare
PUBLIC_ORIGIN=https://curso.tudominio.com

# Puerto del HOST donde escucha el origen (18742 por defecto).
# Alto y poco comun a proposito: en una VPS el 80, 8080 y 3000 suelen estar tomados.
# OJO: Cloudflare en modo proxy pega al origen por 80/443. Con un puerto distinto
# necesitas un Origin Rule, un cloudflared tunnel, o un reverse proxy en la VPS
# que escuche en 443 y reenvie a este puerto.
HTTP_PORT=18742

DATABASE_SSL="false"